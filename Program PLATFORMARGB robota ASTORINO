Załącznik B. Program PLATFORMARGB robota ASTORINO
.PROGRAM PLATFORMARGB

  CALL CLLAMP_OFF
  TWAIT 0.5
  JMOVE P0

  WAIT SIG(1001) OR SIG(1002) OR SIG(1003)

  IF SIG(1001) == TRUE THEN
    KOLOR = 1
  ELSE
    IF SIG(1002) == TRUE THEN
      KOLOR = 2
    ELSE
      IF SIG(1003) == TRUE THEN
        KOLOR = 3
      END
    END
  END

  TWAIT 3.85

  CALL CLLAMP_ON
  TWAIT 0.5
  LMOVE P1
  TWAIT 0.5
  JMOVE P2
  TWAIT 0.5

  IF KOLOR == 1 THEN
    JMOVE P3
    TWAIT 0.5
    LMOVE P4
    TWAIT 0.5
    CALL CLLAMP_OFF
    TWAIT 0.5
    LMOVE P3
    TWAIT 0.5
    JMOVE P2
    JMOVE P0
  END

  IF KOLOR == 2 THEN
    JMOVE P5
    TWAIT 0.5
    LMOVE P6
    TWAIT 0.5
    CALL CLLAMP_OFF
    TWAIT 0.5
    LMOVE P5
    TWAIT 0.5
    JMOVE P2
    JMOVE P0
  END

  IF KOLOR == 3 THEN
    JMOVE P7
    TWAIT 0.5
    LMOVE P8
    TWAIT 0.5
    CALL CLLAMP_OFF
    TWAIT 0.5
    LMOVE P7
    TWAIT 0.5
    JMOVE P2
    JMOVE P0
  END

.END
